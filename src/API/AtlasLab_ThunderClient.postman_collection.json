        },
        {
          "name": "Login - obter token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@atlaslab.local\",\n  \"senha\": \"COLOQUE_SUA_SENHA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login/",
            "description": "Use o e-mail e a senha do administrador criado por criar_admin_atlaslab."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Me - usuário autenticado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/me/"
          },
          "response": []
        },
        {
          "name": "Logout - revogar token atual",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/logout/"
          },
          "response": []
        }
      ]
    },
